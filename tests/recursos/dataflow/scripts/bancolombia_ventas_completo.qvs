// [Bifurcación 1_OPTIONAL_1]
[Agregar 1]:
NOCONCATENATE
LOAD
	[sucursal_id],
	[sucursal_nombre],
	[anio_venta_year],
	[mes_venta_month],
	[categoria],
	Sum([total_venta]) AS [venta_mensual],
	Sum([margen_valor]) AS [margen_mensual],
	Count(DISTINCT [venta_id]) AS [numero_ventas],
	Avg([total_venta]) AS [ticket_promedio]
RESIDENT [Ranking]
GROUP BY [sucursal_id], [sucursal_nombre], [anio_venta_year], [mes_venta_month], [categoria];

STORE [Agregar 1] INTO [lib://Bancolombia prueba:SFTP//upload/resumen_mensual.csv] (txt);

