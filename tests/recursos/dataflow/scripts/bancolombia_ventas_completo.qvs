FROM "demo_dataflow"."ventas_2026";

[Unión 1]:
NOCONCATENATE
LOAD DISTINCT
	[venta_id],
	[fecha_venta],
	[cliente_id],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga]
RESIDENT [Seleccionar campos 1];

DROP TABLE [Seleccionar campos 1];

// [Limpiar 1]
[Cadenas de texto 1]:
NOCONCATENATE
LOAD
	[venta_id],
	[fecha_venta],
	[cliente_id],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	Trim([metodo_pago]) AS [metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga];
LOAD
	[venta_id],
	[fecha_venta],
	[cliente_id],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	IF(Match([metodo_pago], ''), 'NO_INFORMADO', [metodo_pago]) AS [metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga]
RESIDENT [Unión 1];
DROP TABLE [Unión 1];

[Filtro 1_REJECT]:
NOCONCATENATE
LOAD
	[venta_id],
	[fecha_venta],
	[cliente_id],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga]
RESIDENT [Cadenas de texto 1]
WHERE NOT (Coalesce([cantidad] > 0,False()) AND Coalesce([precio_unitario] > 0,False()) AND NOT (IsNull([fecha_venta])) AND NOT (IsNull([producto_id])) AND NOT (IsNull([sucursal_id])) AND IndexRegEx([estado], '^(COMPLETADA|DEVUELTA)$'));

STORE [Filtro 1_REJECT] INTO [lib://Bancolombia prueba:SFTP//upload/ventas_rechazadas.csv] (txt);

DROP TABLE [Filtro 1_REJECT];

// [Filtro 1_DEFAULT]
[Unir 1]:
NOCONCATENATE
LOAD
	[venta_id],
	[fecha_venta],
	[cliente_id],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga]
RESIDENT [Cadenas de texto 1]
WHERE [cantidad] > 0 AND [precio_unitario] > 0 AND NOT (IsNull([fecha_venta])) AND NOT (IsNull([producto_id])) AND NOT (IsNull([sucursal_id])) AND IndexRegEx([estado], '^(COMPLETADA|DEVUELTA)$');

LIB CONNECT TO [Bancolombia prueba:Postgres_BanColombia_Prueba];

LEFT JOIN([Unir 1])
	// [clientes]:
		LOAD
		[cliente_id],
		[documento],
		[nombres],
		[apellidos],
		[email],
		[telefono],
		[direccion_compuesta],
		[fecha_nacimiento],
		[genero],
		[segmento],
		[fecha_registro],
		[sistema_origen];
	SELECT "cliente_id",
	"documento",
	"nombres",
	"apellidos",
	"email",
	"telefono",
	"direccion_compuesta",
	"fecha_nacimiento",
	"genero",
	"segmento",
	"fecha_registro",
	"sistema_origen"
FROM "demo_dataflow"."clientes";

// [Unir 2], [Agregar información de sucursal], [Agregar información del producto], [Renombrar campos de cliente]
[Unir 3]:
NOCONCATENATE
LOAD
	[cliente_id],
	[nombres] AS [cliente_nombres],
	[apellidos] AS [cliente_apellidos],
	[segmento] AS [cliente_segmento],
	[venta_id],
	[fecha_venta],
	[producto_id],
	[sucursal_id],
	[vendedor_id],
	[cantidad],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga]
RESIDENT [Unir 1];
DROP TABLE [Unir 1];

LIB CONNECT TO [Bancolombia prueba:Postgres_BanColombia_Prueba];

LEFT JOIN([Unir 3])
	// [Preparar productos], [productos]
		LOAD
		[producto_id],
		[sku],
		[nombre] AS [producto_nombre],
		[categoria],
		[subcategoria],
		[marca],
		[costo_unitario],
		[precio_lista],
		[peso_kg],
		[fecha_alta] AS [producto_fecha_alta],
		[estado] AS [producto_estado];
	SELECT "producto_id",
	"sku",
	"nombre",
	"categoria",
	"subcategoria",
	"marca",
	"costo_unitario",
	"precio_lista",
	"peso_kg",
	"fecha_alta",
	"estado"
FROM "demo_dataflow"."productos";

LIB CONNECT TO [Bancolombia prueba:Postgres_BanColombia_Prueba];

LEFT JOIN([Unir 3])
	// [Preparar sucursales], [sucursales]
		LOAD
		[sucursal_id],
		[codigo] AS [sucursal_codigo],
		[nombre] AS [sucursal_nombre],
		[ciudad] AS [sucursal_ciudad],
		[region] AS [sucursal_region],
		[fecha_apertura] AS [sucursal_fecha_apertura],
		[activo] AS [sucursal_activa];
	SELECT "sucursal_id",
	"codigo",
	"nombre",
	"ciudad",
	"region",
	"fecha_apertura",
	"activo"
FROM "demo_dataflow"."sucursales";

LIB CONNECT TO [Bancolombia prueba:Postgres_BanColombia_Prueba];

LEFT JOIN([Unir 3])
	// [Preparar vendedores], [vendedores]
		LOAD
		[vendedor_id],
		[codigo_empleado] AS [vendedor_codigo],
		[nombres] AS [vendedor_nombres],
		[apellidos] AS [vendedor_apellidos],
		[sucursal_id] AS [vendedor_sucursal_id],
		[porcentaje_comision] AS [vendedor_comision_pct],
		[fecha_ingreso] AS [vendedor_fecha_ingreso],
		[activo] AS [vendedor_activo];
	SELECT "vendedor_id",
	"codigo_empleado",
	"nombres",
	"apellidos",
	"sucursal_id",
	"porcentaje_comision",
	"fecha_ingreso",
	"activo"
FROM "demo_dataflow"."vendedores";

LIB CONNECT TO [Bancolombia prueba:Postgres_BanColombia_Prueba];

LEFT JOIN([Unir 3])
	// [Preparar devoluciones], [devoluciones]
		LOAD
		[devolucion_id],
		[venta_id],
		[fecha_devolucion],
		[cantidad_devuelta],
		[motivo] AS [devolucion_motivo],
		[importe_devuelto],
		[estado_devolucion] AS [devolucion_estado];
	SELECT "devolucion_id",
	"venta_id",
	"fecha_devolucion",
	"cantidad_devuelta",
	"motivo",
	"importe_devuelto",
	"estado_devolucion"
FROM "demo_dataflow"."devoluciones";

// [Utilidad después de comisión], [Comisión], [Margen], [Costo total], [Total de venta], [IVA], [Subtotal], [Descuento], [Venta bruta], [Extraer mes], [Extraer año]
[Ranking]:
NOCONCATENATE
LOAD
	[venta_id],
	[vendedor_id],
	[sucursal_id],
	[producto_id],
	[cliente_id],
	[cliente_nombres],
	[cliente_apellidos],
	[cliente_segmento],
	[fecha_venta],
	[mes_venta_month],
	[anio_venta_year],
	[cantidad],
	[costo_total],
	[venta_bruta],
	[subtotal],
	[comision_vendedor],
	[margen_valor],
	[margen_valor] * [comision_vendedor] AS [utilidad_neta],
	[total_venta],
	[iva_valor],
	[descuento_valor],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
	[numero_factura],
	[codigo_campana],
	[referencia_origen],
	[importe_reportado_texto],
	[fecha_carga],
	[sku],
	[producto_nombre],
	[categoria],
	[subcategoria],
	[marca],
	[costo_unitario],
	[precio_lista],
	[peso_kg],
	[producto_fecha_alta],
	[producto_estado],
	[sucursal_codigo],
	[sucursal_nombre],
	[sucursal_ciudad],
	[sucursal_region],
	[sucursal_fecha_apertura],
	[sucursal_activa],
	[vendedor_codigo],
	[vendedor_nombres],
	[vendedor_apellidos],
	[vendedor_sucursal_id],
	[vendedor_comision_pct],
	[vendedor_fecha_ingreso],
	[vendedor_activo],
	[devolucion_id],
	[fecha_devolucion],
	[cantidad_devuelta],
	[devolucion_motivo],
	[importe_devuelto],
	[devolucion_estado],
	Window(WRank(1, 1), [sucursal_id], [anio_venta_year], [mes_venta_month], 'DESC', [total_venta]) AS [ranking_venta_mensual];
LOAD
	[venta_id],
	[vendedor_id],
	[sucursal_id],
	[producto_id],
	[cliente_id],
	[cliente_nombres],
	[cliente_apellidos],
	[cliente_segmento],
	[fecha_venta],
	[mes_venta_month],
	[anio_venta_year],
	[cantidad],
	[costo_total],
	[venta_bruta],
	[subtotal],
	[subtotal] * [vendedor_comision_pct] AS [comision_vendedor],
	[subtotal] * [costo_total] AS [margen_valor],
	[total_venta],
	[iva_valor],
	[descuento_valor],
	[precio_unitario],
	[descuento_pct],
	[iva_pct],
	[metodo_pago],
	[canal],
	[estado],
